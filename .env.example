# ==============================================================================
# TotalRPG — Variáveis de Ambiente de Produção (Exemplo)
# Copie este arquivo para .env e preencha os valores antes do deploy
# ==============================================================================

NODE_ENV=production
TZ=America/Sao_Paulo
PORT=3333

# Diretório persistente mapeado como volume no Docker (banco WAL, uploads e packs)
DATA_DIR=/app/data

# SQLite isolado com connection_limit=1 obrigatório para produção (modo WAL ativado no boot)
DATABASE_URL="file:/app/data/prod.db?connection_limit=1"

# Gere uma chave aleatória forte (mínimo 32 caracteres). Ex: openssl rand -hex 32
JWT_SECRET="TROQUE_POR_UMA_CHAVE_FORTE_GERADA_COM_OPENSSL_RAND_HEX_32"

# Domínio público configurado no proxy reverso (HTTPS)
CORS_ORIGIN="https://seu-dominio.com"

# Conta(s) promovida(s) automaticamente a Administrador (separe múltiplas por vírgula)
ADMIN_USERNAME=""
ADMIN_EMAIL=""
